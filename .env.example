# Required on Vercel. Local fallback is balance123 if this is unset.
ADMIN_PASSWORD=balance123

# Optional: durable chats across Vercel deploys (Vercel KV or Upstash Redis REST)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Natural-language understanding (Claude). Without it Buffer falls back to the rule-based parser.
# The brain. Set ONE of these; open models first, all with free tiers. Nothing set = rule-based parser.
# Groq (console.groq.com, free key): Llama 3.3 70B, fast.
GROQ_API_KEY=
# Google AI Studio (aistudio.google.com, free key): Gemma 3 27B by default, or set LLM_MODEL=gemini-2.5-flash.
GEMINI_API_KEY=
# OpenRouter (openrouter.ai): free-tier open models.
OPENROUTER_API_KEY=
# A local Ollama (ollama.com): `ollama pull gemma3`, then OLLAMA_MODEL=gemma3. Only reachable from the machine it runs on.
OLLAMA_MODEL=
# Any other OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Claude, if you would rather.
ANTHROPIC_API_KEY=
